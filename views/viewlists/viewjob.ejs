<!-- Jobs List Header -->
<div class="container" style="text-align: center; padding-top: 1rem;">
    <h1><i class="fas fa-briefcase"></i>&nbsp; Job Opportunities</h1>
    <p style="color: #94a3b8;">Available positions for students</p>
    <a href="/job/add" style="display: inline-block; margin-top: 1rem;">
        <button><i class="fas fa-plus"></i>&nbsp; Post Job</button>
    </a>
</div>

<!-- Jobs Grid -->
<div class="flex">
    <% if(jobs && jobs.length > 0) { %>
        <%for(let job of jobs){%>
            <div class="item">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem;">
                    <div>
                        <h2 style="margin: 0 0 0.25rem 0;"><%= job.role %></h2>
                        <p style="margin: 0; color: #64748b; font-size: 0.875rem;"><i class="fas fa-building"></i>&nbsp; <%= job.company %></p>
                    </div>
                    <div style="background: linear-gradient(135deg, #10b981, #059669); padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; color: white;">
                        💰 <%= job.ctc %>
                    </div>
                </div>
                
                <div style="display: flex; gap: 0.75rem; margin-top: auto; padding-top: 1rem;">
                    <a href="<%= job.link %>" target="_blank" style="flex: 1;">
                        <button style="width: 100%; background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="fas fa-external-link-alt"></i>&nbsp; Apply
                        </button>
                    </a>
                    <a href="/job/details/<%= job.id %>" style="flex: 1;">
                        <button class="btn-secondary" style="width: 100%; background: transparent; border: 1px solid rgba(148,163,184,0.3);">
                            <i class="fas fa-info-circle"></i>&nbsp; Details
                        </button>
                    </a>
                </div>
            </div>
        <%}%>
    <% } else { %>
        <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem;">
            <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;">💼</div>
            <h3>No Jobs Posted</h3>
            <p style="color: #64748b;">Post your first job opportunity</p>
            <a href="/job/add">
                <button style="margin-top: 1rem;"><i class="fas fa-plus"></i>&nbsp; Post Job</button>
            </a>
        </div>
    <% } %>
</div>