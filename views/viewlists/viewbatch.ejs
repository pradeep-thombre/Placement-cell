<!-- Batches List Header -->
<div class="container" style="text-align: center; padding-top: 1rem;">
    <h1><i class="fas fa-users"></i>&nbsp; Batches</h1>
    <p style="color: #94a3b8;">Student batch management</p>
    <a href="/batch/add" style="display: inline-block; margin-top: 1rem;">
        <button><i class="fas fa-plus"></i>&nbsp; Create Batch</button>
    </a>
</div>

<!-- Batches Grid -->
<div class="flex">
    <% if(batches && batches.length > 0) { %>
        <%for(let batch of batches){%>
            <div class="item">
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <div style="width: 50px; height: 50px; border-radius: 12px; background: linear-gradient(135deg, #06b6d4, #0891b2); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                        👥
                    </div>
                    <h2 style="margin: 0;"><%= batch.name %></h2>
                </div>
                <div style="background: rgba(15, 23, 42, 0.4); border-radius: 12px; padding: 1rem;">
                    <p style="display: flex; align-items: center; gap: 0.5rem; margin: 0;">
                        <i class="fas fa-user-tie" style="color: #64748b;"></i>
                        <span style="color: #64748b;">Coordinator:</span>
                        <span><%= batch.cordinator %></span>
                    </p>
                </div>
            </div>
        <%}%>
    <% } else { %>
        <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem;">
            <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;">👥</div>
            <h3>No Batches Created</h3>
            <p style="color: #64748b;">Create your first batch</p>
            <a href="/batch/add">
                <button style="margin-top: 1rem;"><i class="fas fa-plus"></i>&nbsp; Create Batch</button>
            </a>
        </div>
    <% } %>
</div>