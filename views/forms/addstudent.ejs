<!-- Add Student Form -->
<div class="container" style="min-height: 70vh; display: flex; align-items: flex-start; justify-content: center; padding-top: 2rem;">
    <div style="width: 100%; max-width: 500px;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">👨‍🎓</div>
            <h2>Add New Student</h2>
            <p style="color: #94a3b8;">Register a student to the placement cell</p>
        </div>
        
        <form action="/student/create" method="POST">
            <div style="display: grid; gap: 1rem;">
                <div>
                    <label for="name"><i class="fas fa-user"></i>&nbsp; Student Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter student's full name" required>
                </div>
                
                <div>
                    <label for="college"><i class="fas fa-university"></i>&nbsp; College Name</label>
                    <input type="text" id="college" name="college" placeholder="Enter college name" required>
                </div>
                
                <div>
                    <label for="batch"><i class="fas fa-users"></i>&nbsp; Batch</label>
                    <select name="batch" id="batch" required>
                        <option value="" disabled selected>Select a batch</option>
                        <%for(let batch of batches){%>
                            <option value="<%= batch.id%>"><%= batch.name %></option>
                        <%}%>
                    </select>
                </div>
                
                <div>
                    <label for="status"><i class="fas fa-info-circle"></i>&nbsp; Placement Status</label>
                    <select name="status" id="status">
                        <option value="Not Placed" selected>Not Placed</option>
                        <option value="Placed">Placed</option>
                        <option value="Status Unknown">Status Unknown</option>
                    </select>
                </div>
                
                <div>
                    <label for="email"><i class="fas fa-envelope"></i>&nbsp; Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter email address" required>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                    <div>
                        <label for="dsa"><i class="fas fa-code"></i>&nbsp; DSA %</label>
                        <input type="number" id="dsa" name="dsa" placeholder="0-100" min="0" max="100" required>
                    </div>
                    <div>
                        <label for="web"><i class="fas fa-globe"></i>&nbsp; Web %</label>
                        <input type="number" id="web" name="web" placeholder="0-100" min="0" max="100" required>
                    </div>
                    <div>
                        <label for="react"><i class="fab fa-react"></i>&nbsp; React %</label>
                        <input type="number" id="react" name="react" placeholder="0-100" min="0" max="100" required>
                    </div>
                </div>
            </div>
            
            <button type="submit" class="submit" style="margin-top: 1.5rem;">
                <i class="fas fa-plus"></i>&nbsp; Create Student
            </button>
            
            <div style="text-align: center; margin-top: 1rem;">
                <a href="/" style="color: #64748b; font-size: 0.875rem;">
                    <i class="fas fa-arrow-left"></i>&nbsp; Back to Dashboard
                </a>
            </div>
        </form>
    </div>
</div>