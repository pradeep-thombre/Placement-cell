<!-- Create Batch Form -->
<div class="container" style="min-height: 70vh; display: flex; align-items: flex-start; justify-content: center; padding-top: 2rem;">
    <div style="width: 100%; max-width: 450px;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">👥</div>
            <h2>Create Batch</h2>
            <p style="color: #94a3b8;">Organize students into a new batch</p>
        </div>
        
        <form action="/batch/create" method="POST">
            <div style="display: grid; gap: 1rem;">
                <div>
                    <label for="name"><i class="fas fa-users"></i>&nbsp; Batch Name</label>
                    <input type="text" id="name" name="name" placeholder="e.g. Batch 2024-A" required>
                </div>
                
                <div>
                    <label for="cordinator"><i class="fas fa-user-tie"></i>&nbsp; Batch Coordinator</label>
                    <input type="text" id="cordinator" name="cordinator" placeholder="Coordinator's full name" required>
                </div>
            </div>
            
            <button type="submit" class="submit" style="margin-top: 1.5rem;">
                <i class="fas fa-plus"></i>&nbsp; Create Batch
            </button>
            
            <div style="text-align: center; margin-top: 1rem;">
                <a href="/" style="color: #64748b; font-size: 0.875rem;">
                    <i class="fas fa-arrow-left"></i>&nbsp; Back to Dashboard
                </a>
            </div>
        </form>
    </div>
</div>