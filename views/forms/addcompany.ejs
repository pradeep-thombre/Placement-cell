<!-- Create Company Form -->
<div class="container" style="min-height: 70vh; display: flex; align-items: flex-start; justify-content: center; padding-top: 2rem;">
    <div style="width: 100%; max-width: 500px;">
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">🏢</div>
            <h2>Add Company</h2>
            <p style="color: #94a3b8;">Register a new recruiting company</p>
        </div>
        
        <form action="/company/create" method="POST">
            <div style="display: grid; gap: 1rem;">
                <div>
                    <label for="name"><i class="fas fa-building"></i>&nbsp; Company Name</label>
                    <input type="text" id="name" name="name" placeholder="e.g. Google, Microsoft" required>
                </div>
                
                <div>
                    <label for="description"><i class="fas fa-info-circle"></i>&nbsp; Company Description</label>
                    <textarea id="description" name="description" rows="6" placeholder="Brief description about the company, their work culture, and what they do..." required></textarea>
                </div>
            </div>
            
            <button type="submit" class="submit" style="margin-top: 1.5rem;">
                <i class="fas fa-plus"></i>&nbsp; Add Company
            </button>
            
            <div style="text-align: center; margin-top: 1rem;">
                <a href="/" style="color: #64748b; font-size: 0.875rem;">
                    <i class="fas fa-arrow-left"></i>&nbsp; Back to Dashboard
                </a>
            </div>
        </form>
    </div>
</div>