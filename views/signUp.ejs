<!-- Modern Sign Up Form -->
<div class="container" style="min-height: 70vh; display: flex; align-items: center; justify-content: center;">
    <div style="width: 100%; max-width: 400px;">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">🚀</div>
            <h2>Create Account</h2>
            <p style="color: #94a3b8;">Join the Placement Cell platform</p>
        </div>
        
        <form action="/users/create" method="POST">
            <div style="margin-bottom: 1rem;">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" placeholder="Enter your full name" required>
            </div>
            
            <div style="margin-bottom: 1rem;">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            
            <div style="margin-bottom: 1rem;">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Create a password" required>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label for="confirmpassword">Confirm Password</label>
                <input type="password" id="confirmpassword" name="confirmpassword" placeholder="Confirm your password" required>
            </div>
            
            <button type="submit" class="submit">
                <i class="fas fa-user-plus"></i>&nbsp; Create Account
            </button>
        </form>

        <div style="text-align: center; margin-top: 2rem;">
            <p style="color: #64748b; margin-bottom: 1rem;">Already have an account?</p>
            <a href="/users/signIn">
                <button class="btn-secondary" style="background: transparent; border: 1px solid rgba(148,163,184,0.3);">
                    <i class="fas fa-sign-in-alt"></i>&nbsp; Sign In
                </button>
            </a>
        </div>
    </div>
</div>