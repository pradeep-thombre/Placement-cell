<!-- Modern Sign In Form -->
<div class="container" style="min-height: 70vh; display: flex; align-items: center; justify-content: center;">
    <div style="width: 100%; max-width: 400px;">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">🔐</div>
            <h2>Welcome Back!</h2>
            <p style="color: #94a3b8;">Sign in to access your dashboard</p>
        </div>
        
        <form action="/users/createSession" method="POST">
            <div style="margin-bottom: 1rem;">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="Enter your email" required>
            </div>
            
            <div style="margin-bottom: 1.5rem;">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>
            </div>
            
            <button type="submit" class="submit">
                <i class="fas fa-sign-in-alt"></i>&nbsp; Sign In
            </button>
        </form>

        <div style="text-align: center; margin-top: 2rem;">
            <p style="color: #64748b; margin-bottom: 1rem;">Don't have an account?</p>
            <a href="/users/signUp">
                <button class="btn-secondary" style="background: transparent; border: 1px solid rgba(148,163,184,0.3);">
                    <i class="fas fa-user-plus"></i>&nbsp; Create Account
                </button>
            </a>
        </div>
    </div>
</div>